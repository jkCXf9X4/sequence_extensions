<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for the V&V workflow XML (sequence_extensions.workflow.schema).

  A hand-written mirror of the parser's structural rules; the parser is
  authoritative where a mirror cannot follow (duplicate keys and template
  names, unknown function names, and the wrapper's sections, which the
  parser accepts in any document order while this schema pins the
  conventional one: global parameters, then template definitions, then the
  one top-level grouping).

  Global elements: <VerificationWorkflow>, <sequential>, <parallel> and
  <scope> (bare group roots), so a document validates against the global
  element its root names.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- One workflow argument (key/value pair): global parameters, template
       defaults, template use-site bindings and action parameters. -->
  <xs:element name="argument">
    <xs:complexType>
      <xs:attribute name="key" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- One action: a registered function name, its optional description
       label, and its parameters as <argument> children. -->
  <xs:element name="action">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="argument" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="function" type="xs:string" use="required"/>
      <xs:attribute name="description" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- A template use site: a template name and its parameter bindings
       (one use site per reuse). -->
  <xs:element name="use-template">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="argument" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- A template definition: a name, exactly one body grouping and any
       number of <argument> default values.  Both orders are mirrored with a
       deterministic content model: body first (any trailing defaults), or
       at least one default, then the body, then more defaults. -->
  <xs:element name="template">
    <xs:complexType>
      <xs:sequence>
        <xs:choice>
          <xs:sequence>
            <xs:group ref="grouping"/>
            <xs:element ref="argument" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:sequence>
            <xs:element ref="argument" minOccurs="1" maxOccurs="unbounded"/>
            <xs:group ref="grouping"/>
            <xs:element ref="argument" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- The grouping content: one action, one template use site or one
       grouping (nesting is recursive through the group elements, which is
       why the model group is only reached across element particles). -->
  <xs:group name="grouping">
    <xs:choice>
      <xs:element ref="action"/>
      <xs:element ref="use-template"/>
      <xs:element ref="sequential"/>
      <xs:element ref="parallel"/>
      <xs:element ref="scope"/>
    </xs:choice>
  </xs:group>

  <xs:complexType name="groupType">
    <xs:sequence>
      <xs:group ref="grouping" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="on_error">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="capture"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- The explicit grouping form: a group whose 'type' selects the
       execution order. A scope holding exactly one child may OMIT the
       'type' (one child carries no ordering; the parser then builds a
       sequential group). XSD 1.0 cannot express "required unless exactly
       one child", so the attribute is optional here and the parser is
       authoritative on the precise rule. -->
  <xs:element name="scope">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="grouping" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string"/>
      <xs:attribute name="description" type="xs:string"/>
      <xs:attribute name="on_error">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="capture"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="type">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="sequential"/>
            <xs:enumeration value="parallel"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="sequential" type="groupType"/>
  <xs:element name="parallel" type="groupType"/>

  <!-- The wrapper: any number of global parameters, any number of template
       definitions, exactly one top-level grouping. -->
  <xs:element name="VerificationWorkflow">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="argument" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="template" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="grouping"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
